{
  "name": "Royal Fitness Club: website down alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "trigger-5m",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://www.royalfitnesclub.in",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "ping",
      "name": "Open the website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pass on only when the state changed since the last check, so you get one message when the\n// site goes down and one when it is back, not one every 5 minutes.\nconst state = $getWorkflowStaticData('global');\nconst code = $input.first().json.statusCode || 0;\nconst down = code === 0 || code >= 500;\nconst wasDown = state.down === true;\nif (down === wasDown) return [];\nstate.down = down;\nreturn [{ json: { down, code, at: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) } }];"
      },
      "id": "filter-change",
      "name": "Only when it changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "PASTE_YOUR_CHAT_ID",
        "text": "={{ $json.down ? '🔴 royalfitnesclub.in is DOWN (status ' + $json.code + ') at ' + $json.at : '🟢 royalfitnesclub.in is back UP at ' + $json.at }}",
        "additionalFields": {}
      },
      "id": "notify-telegram",
      "name": "Send on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "SET_IN_N8N",
          "name": "Telegram bot (create this credential in n8n)"
        }
      }
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Open the website",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open the website": {
      "main": [
        [
          {
            "node": "Only when it changes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only when it changes": {
      "main": [
        [
          {
            "node": "Send on Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
