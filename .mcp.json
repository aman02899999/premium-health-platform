{
  "mcpServers": {
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com",
      "headers": {
        "Authorization": "Bearer ${APIFY_TOKEN}"
      }
    },
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph==2.3.9",
        "serve"
      ],
      "type": "stdio"
    }
  }
}
