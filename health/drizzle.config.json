{
  "dialect": "postgresql",
  "schema": [
    "./src/db/schema.ts",
    "./src/db/health-schema.ts",
    "./src/db/monetization-schema.ts",
    "./src/db/saas-schema.ts"
  ],
  "dbCredentials": {
    "url": "postgresql://postgres:postgres@127.0.0.1:5432/app_db"
  },
  "schemaFilter": [
    "health"
  ],
  "out": "./drizzle"
}
