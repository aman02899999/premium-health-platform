# Canonical site URL used for canonical tags, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://royalfitnessclub.in

# Supabase (database, Google sign-in, image storage). Both values are public by
# design — access is enforced by row-level security in supabase/migrations/.
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://trcnjdtbaydmtmdmpxbj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Premium Health Platform (the Next.js app in health/, deployed as its own
# Vercel project with Root Directory "health"). The homepage chooser and header
# link point here; unset, they fall back to /health-hub on this site.
NEXT_PUBLIC_HEALTH_PLATFORM_URL=

# Optional single sign-on across both sites. Only works when both are on
# subdomains of one domain you own (e.g. royalfitnessclub.in and
# health.royalfitnessclub.in): set to ".royalfitnessclub.in" in BOTH projects.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Local development without Supabase only: admin password (default "royal-admin"
# in `npm run dev`). Ignored when Supabase is configured.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional: Google Search Console verification (can also be set in /admin → SEO).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
