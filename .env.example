# PostgreSQL connection string used by the Drizzle ORM layer (src/db).
# When unset, the site still boots: the news feed falls back to seed content
# and /api/health reports db: "unconfigured".
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Protects POST/PUT /api/news/publish. When set, writes require the header
#   x-news-token: <NEWS_ADMIN_TOKEN>
# Leave empty to allow unauthenticated writes (not recommended).
NEWS_ADMIN_TOKEN=

# Canonical site URL used for SEO/OG/RSS tags.
# Defaults to https://bharathealthguide.in when unset.
NEXT_PUBLIC_SITE_URL=
