# PostgreSQL connection string used by the Drizzle ORM layer (src/db).
# When unset, the site still boots: the news feed falls back to seed content
# and /api/health reports db: "unconfigured".
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Protects POST/PUT /api/news/publish. When set, writes require the header
#   x-news-token: <NEWS_ADMIN_TOKEN>
# Leave empty to allow unauthenticated writes (not recommended).
NEWS_ADMIN_TOKEN=

# Canonical site URL used for SEO/OG/RSS tags.
# Defaults to https://bharathealthguide.in when unset.
NEXT_PUBLIC_SITE_URL=

# ================= Health Data Integration Layer =================
# All providers are server-side only. Never expose keys to client.

# ---- Provider Enable Flags (true/false) ----
ENABLE_WGER=true
ENABLE_OPENFOODFACTS=true
ENABLE_USDA=false
ENABLE_OPENFDA=true
ENABLE_RXNORM=true
ENABLE_PUBCHEM=true
ENABLE_PUBMED=true
ENABLE_CLINICALTRIALS=true
ENABLE_ICD10=true
ENABLE_SNOMED=false
ENABLE_AYURVEDA=true
ENABLE_HOMEOPATHY=true
ENABLE_INDIAN_MEDICINE=false
ENABLE_WORLDBANK=true
ENABLE_OPENMETEO=true

# ---- API Base URLs (free keyless, override only if self-hosting) ----
WGER_API_URL=https://wger.de/api/v2
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org
USDA_API_URL=https://api.nal.usda.gov/fdc/v1
OPENFDA_API_URL=https://api.fda.gov/drug/label.json
RXNORM_API_URL=https://rxnav.nlm.nih.gov/REST
PUBCHEM_API_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
PUBMED_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
CLINICALTRIALS_API_URL=https://clinicaltrials.gov/api/v2/studies
ICD10_API_URL=https://id.who.int/icd/release/11/2024-01/mms
SNOMED_API_URL=http://localhost:8080/snowstorm/snomed-ct
AYURVEDA_API_URL=local-dataset
HOMEOPATHY_API_URL=local-dataset
INDIAN_MEDICINE_API_URL=https://eka.care/api
WORLDBANK_API_URL=https://api.worldbank.org/v2
OPENMETEO_API_URL=https://api.open-meteo.com/v1

# ---- API Keys (only for providers that require them) ----
# USDA FoodData Central: free key from https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# OpenFDA: optional key increases rate limit, not required. Get from https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# SNOMED CT: requires self-hosted Snowstorm + UMLS license, no public key
# SNOMED_API_KEY=

# Indian Medicines / EKA: requires commercial partnership
INDIAN_MEDICINE_API_KEY=

# ---- Caching ----
# Optional Redis URL for distributed caching. If unset, uses in-memory cache.
REDIS_URL=

# ---- Rate Limiting ----
HEALTH_API_RATE_LIMIT_PER_MINUTE=60

# ---- Data Sync ----
HEALTH_SYNC_CRON_ENABLED=false
HEALTH_SYNC_INTERVAL_HOURS=24

# ================= SEO / SSO / Digital Marketing / Earning (Pro) =================
# Google Analytics 4 — for page_view, scroll_depth, affiliate_click, generate_lead
NEXT_PUBLIC_GA_ID=
# Facebook Pixel — for PageView, ViewContent
NEXT_PUBLIC_FB_PIXEL_ID=
# Google Search Console verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# SSO — Google OAuth (for NextAuth migration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Razorpay / UPI for premium (future) — Payment abstraction supports mock + razorpay + stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_PROVIDER=mock
# Generic payment provider keys (for abstraction — maps to Razorpay/Stripe/PayPal)
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
# AdSense + other ad networks
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Affiliate
NEXT_PUBLIC_AFFILIATE_DEFAULT_MERCHANT=Amazon
AFFILIATE_NETWORK_ID=
# Analytics — privacy-conscious
ANALYTICS_ID=
# Email provider for receipts, newsletter, download links
EMAIL_PROVIDER_KEY=
# Storage bucket for private PDFs — S3/R2 — never public URLs, use presigned URLs
STORAGE_BUCKET=
PRIVATE_PDF_BUCKET=
# Newsletter provider (optional — e.g., ConvertKit, Mailchimp)
NEWSLETTER_PROVIDER_KEY=
NEWSLETTER_PROVIDER_SECRET=
# WhatsApp + Push providers for monetization
WHATSAPP_PROVIDER_KEY=
PUSH_PROVIDER_KEY=
# Lead CRM (optional)
LEAD_CRM_API_KEY=

