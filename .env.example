# Canonical site URL used for canonical tags, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://royalfitnessclub.in

# Admin panel (/admin). REQUIRED in production — without it the admin is disabled.
# In `npm run dev` the fallback password is "royal-admin".
ADMIN_PASSWORD=
# Optional separate secret for signing admin session cookies (defaults to ADMIN_PASSWORD).
ADMIN_SECRET=

# Storage for admin edits, uploaded images and trial enquiries.
# Set this on serverless hosts (Vercel, Netlify) — their filesystem is read-only.
# Without it, data is stored as JSON/files in ./.data (fine for a VPS or local dev).
# Tables are created automatically on first use.
DATABASE_URL=

# Optional: Google Search Console verification (can also be set in /admin → SEO).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
