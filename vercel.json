{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "crons": [
    {
      "path": "/health/api/cron/daily",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/reel",
